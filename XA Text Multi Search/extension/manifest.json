{
  "manifest_version": 3,
  "name": "XA Text Multi Search",
  "version": "1.0.0",
  "description": "Find multiple words and phrases, color matches, and navigate results locally.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "XA Text Multi Search"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "model.js",
        "panel.js",
        "page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/48.png"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      }
    },
    "next": {
      "description": "Next occurrence"
    },
    "prev": {
      "description": "Previous occurrence"
    },
    "add": {
      "description": "Add selected text"
    },
    "clear": {
      "description": "Clear search list"
    },
    "flash": {
      "description": "Flash matches"
    },
    "highlights": {
      "description": "Toggle highlighting"
    },
    "marks": {
      "description": "Toggle page markers"
    },
    "sound": {
      "description": "Toggle sound"
    },
    "style": {
      "description": "Cycle highlight style"
    },
    "case": {
      "description": "Toggle case sensitivity"
    },
    "accents": {
      "description": "Toggle accent sensitivity"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
